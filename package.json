{
  "name": "@attractor/production-ai-checklist",
  "version": "0.1.0",
  "description": "Validate evidence-based production AI readiness assessments.",
  "type": "module",
  "bin": {
    "production-ai-checklist": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "checklist",
    "schemas",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check:examples": "npm run build && node dist/src/cli.js validate examples/assessment.production.json"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "production-ai",
    "ai-engineering",
    "llmops",
    "checklist",
    "ci-cd"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "typescript": "7.0.2"
  }
}
